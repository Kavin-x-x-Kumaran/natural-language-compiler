# Optional. The backend works without a .env file: every value below is the
# default. Copy this file to backend/.env only if you need to change one.

SERVER_PORT=8000
LLAMA_PORT=8080
COMPILE_ROUTE=/compile
WS_RUN_ROUTE=/ws/run

# Full path to gcc, only if it is somewhere the backend does not look
# (PATH, or C:\msys64 on Windows). Use forward slashes:
# NLC_GCC=C:/msys64/ucrt64/bin/gcc.exe

# npm run dev starts llama-server itself when llama.cpp is installed.
# Use a .gguf file you already have instead of downloading Qwen3 4B:
# LLAMA_MODEL_FILE=C:/models/Qwen3-4B-Q4_K_M.gguf
# Do not start llama-server automatically (e.g. you start it yourself):
# LLAMA_AUTOSTART=false
