# These values are PLACEHOLDERS for a backend that does not exist yet.
# Setting them does NOT mean a server is running at these addresses; the
# frontend only reports "Backend connected" after a real successful call.
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_WS_BASE_URL=ws://127.0.0.1:8000

# Development only. When true, generation and execution are SIMULATED
# locally and clearly labelled "[mock]". Never enable this to demo real output.
VITE_ENABLE_MOCK=false
