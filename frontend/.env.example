# Optional. The frontend works without a .env file: it talks to the backend
# at http://127.0.0.1:8000. Copy this file to frontend/.env only if the
# backend runs somewhere else.
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_WS_BASE_URL=ws://127.0.0.1:8000

# Development only. When true, generation and execution are SIMULATED in the
# browser and clearly labelled "[mock]". Never use this to demo real output.
VITE_ENABLE_MOCK=false
